DATABASE_URL=postgres://user:pass@host:5432/db
APP_URL=https://your-app.vercel.app
# Admin sign-in needs all three: username, password and token. The username can be anything; it defaults to "admin".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-a-long-passphrase
ADMIN_TOKEN=change-me-long-random
ADMIN_EMAIL=you@example.com
CRON_SECRET=change-me-long-random
EMAIL_FROM=Team Tracker <tracker@yourdomain.com>
RESEND_API_KEY=re_xxx
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional: override the Resend endpoint (used for local testing only)
# RESEND_API_URL=
